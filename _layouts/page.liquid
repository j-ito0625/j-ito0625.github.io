---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header{% if page.permalink == '/news/' %} post-header-news{% endif %}{% if page.permalink == '/cv/' %} post-header-cv{% endif %}">
    {% if page.permalink == '/news/' %}
      <h1 class="post-title about-section-heading about-section-heading-news-page">{{ page.title }}</h1>
    {% elsif page.permalink == '/publications/' %}
      <h1 class="post-title publications-page-title">{{ page.title }}</h1>
    {% elsif page.permalink == '/projects/' %}
      <h1 class="post-title projects-page-title">{{ page.title }}</h1>
    {% elsif page.collection == 'projects' %}
      <h1 class="post-title projects-page-title project-detail-title">{{ page.title }}</h1>
    {% else %}
      <h1 class="post-title">{{ page.title }}</h1>
    {% endif %}
    {% if page.description %}
      <p class="post-description{% if page.collection == 'projects' %} project-detail-description{% endif %}">{{ page.description }}</p>
    {% endif %}
  </header>

  <article class="{% if page.permalink == '/publications/' %}publications{% endif %}">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
