---
layout: default
---
<div class="post">
  <header class="post-header">
    <div style="display: flex; align-items: flex-start; gap: 2rem; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 300px;">
        <h1 class="post-title">
          {% if page.custom_name %}
            <span style="font-weight: 400;">{{ page.custom_name }}</span>
          {% elsif site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <div class="desc">{{ page.subtitle }}</div>
        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
      </div>
      {% if page.profile and page.profile.image %}
        <div class="about-photo-wrapper">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% assign profile_image_front_class = profile_image_class | append: ' about-photo-front-image' %}
          {% assign profile_image_back_class = profile_image_class | append: ' about-photo-back-image' %}
          {% capture front_sizes %}200px{% endcapture %}
          {% capture back_sizes %}280px{% endcapture %}

          <a href="{{ '/cv/' | relative_url }}" class="about-photo-classic">
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=front_sizes alt=page.profile.image
              cache_bust=true
            %}
          </a>

          <div class="about-photo-stack">
            <div class="about-photo-layer about-photo-layer-back" aria-hidden="true">
              {%
                include figure.liquid loading="eager" path=profile_image_path class=profile_image_back_class sizes=back_sizes alt=page.profile.image
                cache_bust=true
              %}
            </div>
            <a href="{{ '/cv/' | relative_url }}" class="about-photo-layer about-photo-layer-front">
              {%
                include figure.liquid loading="eager" path=profile_image_path class=profile_image_front_class sizes=front_sizes alt=page.profile.image
                cache_bust=true
              %}
            </a>
          </div>

          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="about-section-heading about-section-heading-news">
        <span>NEWS</span>
        <span class="about-section-heading-meta">(<a href="{{ '/news/' | relative_url }}">MORE</a>)</span>
        <span class="about-section-heading-note">* : UPCOMING CONFERENCES</span>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}
  </article>
</div>
