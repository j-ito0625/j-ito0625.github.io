<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_wrapper_class = 'table-responsive news-table-wrapper' %}
    {% if include.limit and page.announcements.scrollable and news_size > 3 %}
      {% assign news_wrapper_class = news_wrapper_class | append: ' news-scrollable' %}
    {% endif %}
    <div class="{{ news_wrapper_class }}">
      <table class="table table-sm table-borderless news-table">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          {% assign highlight_milestone = item.milestone and include.limit != true %}
          <tr class="news-row{% if item.important %} news-row-important{% endif %}{% if highlight_milestone %} news-row-milestone{% endif %}">
            <th scope="row" class="news-date">{{ item.date | date: '%b %d, %Y' }}</th>
            <td class="news-content">
              {% if item.inline %}
                {% if item.important %}
                  <span class="news-inline-important">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</span>
                {% else %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% endif %}
              {% else %}
                {% if item.important %}
                  <a class="news-title news-title-important" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
